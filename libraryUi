-- UI: Notification (Slide + Fade + Progress Shrink)
function CrystalUI:Notify(opts)
    opts = opts or {}
    local title = opts.Title or "Crystal UI"
    local content = opts.Content or ""
    local duration = opts.Duration or 3.5

    local Card = Instance.new("Frame")
    Card.Size = UDim2.new(1, 0, 0, 70)
    Card.Position = UDim2.new(1, 340, 0, 0)
    Card.BackgroundColor3 = DefaultTheme.Card
    Card.BackgroundTransparency = 0.2
    Card.ClipsDescendants = true
    Card.Parent = NotifHolder
    Corner(Card, 10)
    local st = Stroke(Card, DefaultTheme.Pink, 1.2)
    Gradient(st, DefaultTheme.Purple, DefaultTheme.Pink, 45)

    local Bar = Instance.new("Frame")
    Bar.Size = UDim2.new(0, 4, 1, 0)
    Bar.BackgroundColor3 = Color3.new(1, 1, 1)
    Bar.Parent = Card
    Gradient(Bar, DefaultTheme.Purple, DefaultTheme.Pink, 90)

    local T = Instance.new("TextLabel")
    T.Size = UDim2.new(1, -20, 0, 22)
    T.Position = UDim2.new(0, 14, 0, 8)
    T.BackgroundTransparency = 1
    T.Text = title
    T.Font = Enum.Font.GothamBold
    T.TextSize = 13
    T.TextColor3 = DefaultTheme.Text
    T.TextXAlignment = Enum.TextXAlignment.Left
    T.Parent = Card

    local C = Instance.new("TextLabel")
    C.Size = UDim2.new(1, -20, 0, 32)
    C.Position = UDim2.new(0, 14, 0, 28)
    C.BackgroundTransparency = 1
    C.Text = content
    C.Font = Enum.Font.Gotham
    C.TextSize = 12
    C.TextColor3 = DefaultTheme.Muted
    C.TextWrapped = true
    C.TextXAlignment = Enum.TextXAlignment.Left
    C.TextYAlignment = Enum.TextYAlignment.Top
    C.Parent = Card

    local LifeBar = Instance.new("Frame")
    LifeBar.Size = UDim2.new(1, 0, 0, 3)
    LifeBar.Position = UDim2.new(0, 0, 1, -3)
    LifeBar.BackgroundColor3 = Color3.new(1, 1, 1)
    LifeBar.BorderSizePixel = 0
    LifeBar.Parent = Card
    Gradient(LifeBar, DefaultTheme.Purple, DefaultTheme.Pink, 0)

    Tween(Card, {Position = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 0}, 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(LifeBar, {Size = UDim2.new(0, 0, 0, 3)}, duration, Enum.EasingStyle.Linear, Enum.EasingDirection.In)

    task.delay(duration, function()
        if Card and Card.Parent then
            Tween(Card, {Position = UDim2.new(1, 340, 0, 0), BackgroundTransparency = 1}, 0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            Tween(T, {TextTransparency = 1}, 0.2)
            Tween(C, {TextTransparency = 1}, 0.2)
            Tween(st, {Transparency = 1}, 0.2)
            task.wait(0.3)
            if Card and Card.Parent then Card:Destroy() end
        end
    end)
end

