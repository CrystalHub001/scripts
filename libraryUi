        local TabBtn = Instance.new("TextButton")
        TabBtn.Size = UDim2.new(0, 134, 0, 34)
        TabBtn.BackgroundColor3 = T.Card
        TabBtn.BackgroundTransparency = 1
        TabBtn.Text = name
