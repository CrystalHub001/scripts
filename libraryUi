        -- Element: Slider (Smooth Bar Fill)
        function Elem:CreateSlider(opts)
            opts = opts or {}
            local minV = opts.Min or 0
            local maxV = opts.Max or 100
            local val = opts.Default or minV
            if opts.Flag then ConfigStore[opts.Flag] = val end

            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(0, W, 0, 52)
            frame.BackgroundColor3 = T.Card
            frame.Parent = Page
            Corner(frame, 8)
            local st = Stroke(frame, T.Stroke, 1)

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0, 240, 0, 22)
            lbl.Position = UDim2.new(0, 12, 0, 4)
            lbl.BackgroundTransparency = 1
            lbl.Text = opts.Name or "Slider"
            lbl.Font = Enum.Font.GothamMedium
            lbl.TextSize = 13
            lbl.TextColor3 = T.Text
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = frame

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0, 80, 0, 22)
            valLbl.Position = UDim2.new(1, -92, 0, 4)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(val)
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 13
            valLbl.TextColor3 = T.Pink
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = frame

            local barBg = Instance.new("Frame")
            barBg.Size = UDim2.new(0, W - 24, 0, 6)
            barBg.Position = UDim2.new(0, 12, 0, 34)
            barBg.BackgroundColor3 = T.Sidebar
            barBg.Parent = frame
            Corner(barBg, 3)

            local barFill = Instance.new("Frame")
            barFill.Size = UDim2.new(math.clamp((val - minV) / (maxV - minV), 0, 1), 0, 1, 0)
            barFill.BackgroundColor3 = Color3.new(1, 1, 1)
            barFill.Parent = barBg
            Corner(barFill, 3)
            Gradient(barFill, T.Purple, T.Pink, 0)

            local function SetValue(newVal, fire)
                val = math.clamp(math.floor(newVal), minV, maxV)
                if opts.Flag then ConfigStore[opts.Flag] = val end
                valLbl.Text = tostring(val)
                local ratio = (val - minV) / (maxV - minV)
                Tween(barFill, {Size = UDim2.new(ratio, 0, 1, 0)}, 0.12, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
                if fire ~= false and opts.Callback then opts.Callback(val) end
            end

            if opts.Flag then RegisteredSetters[opts.Flag] = function(v) SetValue(v, true) end end

            local dragging = false
            local function UpdateFromInput(input)
                local pct = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                SetValue(minV + ((maxV - minV) * pct), true)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    Tween(barBg, {Size = UDim2.new(0, W - 24, 0, 8), Position = UDim2.new(0, 12, 0, 33)}, 0.12)
                    Tween(st, {Color = T.Pink}, 0.12)
                    UpdateFromInput(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        Tween(barBg, {Size = UDim2.new(0, W - 24, 0, 6), Position = UDim2.new(0, 12, 0, 34)}, 0.14)
                        Tween(st, {Color = T.Stroke}, 0.14)
                    end
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    UpdateFromInput(input)
                end
            end)
        end

