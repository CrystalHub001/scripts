    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.ZIndex = 52
    Title.Parent = Box

    local Desc = Instance.new("TextLabel")
    Desc.Size = UDim2.new(1, -24, 0, 56)
    Desc.Position = UDim2.new(0, 12, 0, 42)
    Desc.BackgroundTransparency = 1
    Desc.Text = opts.Content or ""
    Desc.Font = Enum.Font.Gotham
    Desc.TextSize = 12
    Desc.TextColor3 = DefaultTheme.Muted
    Desc.TextTransparency = 1
    Desc.TextWrapped = true
    Desc.TextXAlignment = Enum.TextXAlignment.Left
    Desc.TextYAlignment = Enum.TextYAlignment.Top
    Desc.ZIndex = 52
    Desc.Parent = Box

    Tween(Overlay, {BackgroundTransparency = 0.5}, 0.22)
    Tween(Box, {Size = UDim2.new(0, 340, 0, 165), Position = UDim2.new(0.5, -170, 0.5, -82), BackgroundTransparency = 0}, 0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    Tween(st, {Transparency = 0}, 0.22)
    Tween(Title, {TextTransparency = 0}, 0.22)
    Tween(Desc, {TextTransparency = 0}, 0.22)

    local function CloseDialog(cb)
        Tween(Overlay, {BackgroundTransparency = 1}, 0.2)
        Tween(Box, {Size = UDim2.new(0, 300, 0, 145), Position = UDim2.new(0.5, -150, 0.5, -72), BackgroundTransparency = 1}, 0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        Tween(st, {Transparency = 1}, 0.18)
        Tween(Title, {TextTransparency = 1}, 0.18)
        Tween(Desc, {TextTransparency = 1}, 0.18)
        task.wait(0.22)
        Overlay:Destroy()
        if cb then cb() end
    end

    local function MakeBtn(text, xOffset, primary, cb)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0, 150, 0, 34)
        b.Position = UDim2.new(0, xOffset, 1, -46)
        b.BackgroundColor3 = primary and DefaultTheme.Pink or DefaultTheme.Card
        b.Text = text
        b.Font = Enum.Font.GothamBold
        b.TextSize = 12
        b.TextColor3 = DefaultTheme.Text
        b.AutoButtonColor = false
        b.ZIndex = 52
        b.Parent = Box
        Corner(b, 8)
        if primary then Gradient(b, DefaultTheme.Purple, DefaultTheme.Pink, 0) end

        b.MouseEnter:Connect(function()
            Tween(b, {Size = UDim2.new(0, 152, 0, 35)}, 0.12)
        end)
        b.MouseLeave:Connect(function()
            Tween(b, {Size = UDim2.new(0, 150, 0, 34)}, 0.12)
        end)
        b.MouseButton1Click:Connect(function()
            CloseDialog(cb)
        end)
    end

    MakeBtn(opts.CancelText or "Cancel", 12, false, opts.OnCancel)
    MakeBtn(opts.ConfirmText or "Confirm", 178, true, opts.OnConfirm)
end

