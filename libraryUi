        })

        tab:CreateButton({
            Name = "Load Config",
            Callback = function()
                if savedRaw == "" then
                    CrystalUI:Notify({Title = "No Config", Content = "Save a config first.", Duration = 2.5})
                    return
                end
                local ok, decoded = pcall(function() return HttpService:JSONDecode(savedRaw) end)
                if ok and type(decoded) == "table" then
                    for flag, value in pairs(decoded) do
                        ConfigStore[flag] = value
                        if RegisteredSetters[flag] then
                            RegisteredSetters[flag](value)
                        end
                    end
                    CrystalUI:Notify({Title = "Config Loaded", Content = "Applied saved settings.", Duration = 2.5})
                end
            end
        })
        return tab
    end

    return Win
end

return CrystalUI
